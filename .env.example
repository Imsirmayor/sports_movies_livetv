# ═══════════════════════════════════════════════════════════════════════════
# Pulse Stream — copy to `.env` in the repo root (never commit `.env`)
# Shared by: API (services/api), Web BFF (apps/web)
# ═══════════════════════════════════════════════════════════════════════════

# ── Required ──────────────────────────────────────────────────────────────
# Long random secret. Web BFF and mobile app must use the SAME value.
API_TOKEN=

# Where the API listens
API_HOST=127.0.0.1
API_PORT=8787

# Web BFF → API (server-side only; browser never sees API_TOKEN)
API_BASE_URL=http://127.0.0.1:8787

# Local sample / fixture media folder (must exist)
MEDIA_ROOT=media/samples
MEDIA_WORK_ROOT=.media-work
FFMPEG_BINARY=ffmpeg

# ── Catalog / sports ──────────────────────────────────────────────────────
# fixture = demo sports + local MEDIA_ROOT
# sportsurge = live StreamEast-style listings (scrape)
# none = sports discovery disabled
SPORTS_PROVIDER=fixture
# SPORTS_EVENTS_CACHE_MS=8000

# Torrentio + RealDebrid (required for movies/series catalog streams)
# https://torrentio.strem.fun/configure → paste full addon URL
STREMIO_ADDON_URL=
MAX_RESOLUTION=720

# ── Capacity (production VPS: keep jobs LOW) ──────────────────────────────
MAX_CONCURRENT_JOBS=2
MAX_EDGE_SESSIONS=24
JOB_TIMEOUT_MS=120000
LOG_LEVEL=INFO

# ── HLS cache (disk) ──────────────────────────────────────────────────────
# Each cached movie ≈ 0.5–2GB. Cap entries on small disks.
STREAM_CACHE_ROOT=.media-cache
STREAM_CACHE_MAX_ENTRIES=20

# Background warmer (0 interval = off). Prefer FULL_REMUX=false on small VPS.
CATALOG_WARM_INTERVAL_MS=1800000
CATALOG_WARM_COUNT=5
CATALOG_WARM_FULL_REMUX=false

# ── Cloudflare R2 CDN (optional) ──────────────────────────────────────────
# When ALL of these are set: remux → local .media-cache → upload R2;
# warm plays use the public playlist (streamDelivery=r2_then_local).
# When unset or upload fails: serve from local .media-cache only.
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=
# R2_PUBLIC_BASE_URL=https://pub-xxxx.r2.dev
# R2_PREFIX=hls

# ── Web UI ────────────────────────────────────────────────────────────────
# NEXT_PUBLIC_BRAND_NAME=Pulse Stream

# ── Ads / pre-roll ────────────────────────────────────────────────────────
ADS_ENABLED=true
ADS_PREROLL_ENABLED=false
ADS_SKIP_AFTER_SEC=5
ADS_NETWORK_PRIORITY=admob,applovin,vast,house
# ADMOB_ANDROID_APP_ID=ca-app-pub-xxxx~yyyy
# ADMOB_REWARDED_ANDROID=ca-app-pub-xxxx/zzzz
# ADS_VAST_TAG_URL=off
