# ── Discord bot (existing) ───────────────────────────────────────────────
# Discord Bot Token (from Discord Developer Portal)
BOT_TOKEN=

# Discord User Token (for selfbot streaming)
USER_TOKEN=

# Stremio Addon URL (Torrentio with RealDebrid config)
STREMIO_ADDON_URL=

# Optional AMP-overridable settings
# MAX_RESOLUTION=720
# MAX_FPS=30
# VIDEO_BITRATE=2500
# HARDWARE_ACCEL=auto

# Optional: TMDB fallback when Cinemeta has no results
# TMDB_API_KEY=

# ── Educational REST API (Phase Two) ─────────────────────────────────────
# Required to start services/api. Use a long random value for local testing.
API_TOKEN=

# Bind address (default loopback only)
API_HOST=127.0.0.1
API_PORT=8787

# Absolute or repo-relative path. Only files directly in this directory are listed.
# Must exist before the API starts. Generate a sample with: pnpm sample:generate
MEDIA_ROOT=media/samples

# Temporary HLS output directory (created if missing; do not put secrets here)
MEDIA_WORK_ROOT=.media-work

# FFmpeg binary name or absolute path
FFMPEG_BINARY=ffmpeg

# Resource limits
# Heavy = FFmpeg remux/transcode (local machine, not RealDebrid). Cached/R2 = edge slots.
# Raise these if you see CAPACITY / "Too many concurrent playback sessions".
MAX_CONCURRENT_JOBS=50
MAX_EDGE_SESSIONS=200
JOB_TIMEOUT_MS=120000

# Shared logging (bot + API)
# LOG_LEVEL=INFO

# ── Sports (Phase 2B + bot port) ─────────────────────────────────────────
# fixture    = educational events + local MEDIA_ROOT stand-in (recommended)
# sportsurge = Discord /live path — sportsurge.ws is currently seized / unavailable
# none       = discovery returns PROVIDER_UNAVAILABLE
SPORTS_PROVIDER=fixture

# Optional. Media id from GET /api/media used for fixture live playback
# Optional local media id if you re-enable streamAvailability=fixture on an event.
# When unset, the API uses the first MEDIA_ROOT catalog item.
# SPORTS_FIXTURE_MEDIA_ID=

# Movie catalog (Cinemeta search + Torrentio streams) — same URL as the Discord bot.
# Required for /api/catalog/movies/* and web Movies catalog search.
# STREMIO_ADDON_URL=
# MAX_RESOLUTION=720

# Local HLS remux cache (repeat plays skip RD + FFmpeg). Set to "off" to disable.
# STREAM_CACHE_ROOT=.media-cache
# STREAM_CACHE_MAX_ENTRIES=40

# Background warmer: poke RealDebrid for popular titles; optionally remux into cache when idle.
# Interval 0 disables. Full remux leaves one heavy slot free for interactive play.
# CATALOG_WARM_INTERVAL_MS=1800000
# CATALOG_WARM_COUNT=5
# CATALOG_WARM_FULL_REMUX=true

# Optional Cloudflare R2 CDN (S3 API). After remux, HLS is uploaded; playback uses the
# public playlist URL (no FFmpeg slot). Bucket needs public access or a custom domain + CORS.
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=
# R2_PUBLIC_BASE_URL=https://pub-xxxx.r2.dev
# R2_PREFIX=hls

# ── Web app BFF (apps/web) ───────────────────────────────────────────────
# Server-only. The browser never receives API_TOKEN; Next.js proxies
# /api/backend/* → API_BASE_URL/api/* with the bearer token attached.
API_BASE_URL=http://127.0.0.1:8787
# Reuses API_TOKEN above. Optional apps/web/.env.local may override.

# Optional public brand label shown in the web UI (default: Bowa)
# NEXT_PUBLIC_BRAND_NAME=Bowa
